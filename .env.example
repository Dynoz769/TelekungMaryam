# Copy this to Vercel's Environment Variables settings for the project
# (Project Settings > Environment Variables). Do NOT commit a real .env file.

# From ToyyibPay dashboard > Profile > Get Started (or Settings)
TOYYIBPAY_SECRET_KEY=

# From ToyyibPay dashboard > Category > (your category) > Category Code
TOYYIBPAY_CATEGORY_CODE=

# Sandbox while testing, production once you're ready to accept real payments:
#   https://dev.toyyibpay.com
#   https://toyyibpay.com
TOYYIBPAY_BASE_URL=https://dev.toyyibpay.com

# Your storefront's public URL (used to build ToyyibPay's return URL)
SITE_URL=https://telekungmaryam.com.my

# Comma-separated list of origins allowed to call the API (CORS). Include
# both the custom domain and the default GitHub Pages URL if the custom
# domain's DNS isn't fully live yet.
ALLOWED_ORIGIN=https://telekungmaryam.com.my,https://dynoz769.github.io

# --- Admin panel (admin.html) -- see ADMIN_SETUP.md ---

# Fine-grained GitHub Personal Access Token, scoped to ONLY this repo, with
# "Contents: Read and write" permission. Used to commit product/price/image
# changes made in admin.html, and to read the live price list at checkout.
GITHUB_TOKEN=

# "owner/repo" of this repository
GITHUB_REPO=Dynoz769/TelekungMaryam

# Branch admin.html commits to (must match the branch GitHub Pages/Vercel deploy from)
GITHUB_BRANCH=main

# The password admin.html asks for. Pick something strong -- it protects
# write access to your repo (product data + images).
ADMIN_PASSWORD=

# Random secret used to sign admin session tokens. Generate one with:
#   openssl rand -hex 32
ADMIN_SESSION_SECRET=
