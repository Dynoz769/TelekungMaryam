# Copy this to Vercel's Environment Variables settings for the project
# (Project Settings > Environment Variables). Do NOT commit a real .env file.

# From Billplz dashboard > Settings > API Key
BILLPLZ_API_KEY=

# From Billplz dashboard > Collections > (your collection) > Collection ID
BILLPLZ_COLLECTION_ID=

# From Billplz dashboard > Settings > X Signature Key
BILLPLZ_X_SIGNATURE_KEY=

# Sandbox while testing, production once your Billplz account is verified:
#   https://www.billplz-sandbox.com
#   https://www.billplz.com
BILLPLZ_BASE_URL=https://www.billplz-sandbox.com

# Your storefront's public URL (used to build Billplz's redirect/callback URLs)
SITE_URL=https://telekungmaryam.com.my

# Only this origin is allowed to call the API (CORS). Set to your storefront.
ALLOWED_ORIGIN=https://telekungmaryam.com.my
